{
	"name": "@braise/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"braise": "./src/cli.ts"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"drizzle"
	],
	"scripts": {
		"clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
		"build": "tsc -p tsconfig.build.json",
		"dev": "braise serve --watch"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"drizzle-kit": "0.31.11"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.331",
		"@braise/core": "0.0.0",
		"@hono/node-server": "2.1.11",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.21",
		"pg": "8.23.1",
		"pg-boss": "12.39.0",
		"uuid": "14.0.3",
		"zod": "4.6.7"
	}
}
