{
	"name": "braise",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/core",
		"packages/api",
		"packages/web"
	],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"lint": "biome check . && oxlint --deny-warnings",
		"typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
		"format": "biome check --write . && oxlint --fix",
		"test": "vitest run --passWithNoTests",
		"prepare": "husky",
		"dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w @braise/api\" \"npm run dev -w @braise/web\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@interfere/landmines": "0.3.1",
		"@types/node": "22.19.19",
		"concurrently": "10.0.7",
		"husky": "9.1.7",
		"oxlint": "1.95.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
