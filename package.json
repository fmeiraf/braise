{
	"name": "braise",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"husky": "9.1.7",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
